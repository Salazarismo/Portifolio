---
type Props = {
  logoHref: string;
  ptHref: string;
  enHref: string;
  isEN?: boolean;
  eyebrow: string;
  title: string;
  description: string;
  recruiterTag: string;
  recruiterHeadline: string;
  recruiterSub: string;
  recruiterArrow: string;
  recruiterHref: string;
  clientTag: string;
  clientHeadline: string;
  clientSub: string;
  clientArrow: string;
  clientHref: string;
  footerEmailLabel: string;
  footerCopy: string;
};

const props = Astro.props as Props;
---
<style is:global>
  body.page-home {
    --charcoal:    #1a1a1a;
    --charcoal-2:  #222222;
    --charcoal-3:  #2e2e2e;
    --amber:       #c8922a;
    --amber-light: #e0a83a;
    --gold:        #d4a843;
    --off-white:   #f0ece4;
    --muted:       #7a7570;
    --border:      rgba(200, 146, 42, 0.18);
    --border-dim:  rgba(255,255,255,0.07);
    background: var(--charcoal);
    color: var(--off-white);
    font-family: 'Syne', sans-serif;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  body.page-home::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    opacity: 0.5;
  }

  body.page-home nav[aria-label="Principal"] {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1.5rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-dim);
    background: rgba(26,26,26,0.85);
    backdrop-filter: blur(12px);
  }

  body.page-home .nav-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--off-white);
    text-decoration: none;
    opacity: 0.8;
  }
  body.page-home .nav-logo span { color: var(--amber); }

  body.page-home .nav-lang {
    display: flex;
    gap: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }
  body.page-home .nav-lang a {
    color: var(--muted);
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  body.page-home .nav-lang a:hover,
  body.page-home .nav-lang a.active { color: var(--amber); }
  body.page-home .nav-lang span { color: var(--border); }

  body.page-home main#main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8rem 2rem 4rem;
    position: relative;
    z-index: 1;
  }

  body.page-home main#main::after {
    content: '';
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(ellipse, rgba(200,146,42,0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  body.page-home .hero {
    text-align: center;
    max-width: 780px;
    width: 100%;
    position: relative;
  }

  body.page-home .hero-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 1.6rem;
    opacity: 0;
    animation: homeFadeUp 0.6s ease forwards 0.1s;
  }

  body.page-home .hero-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3rem, 8vw, 5.8rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--off-white);
    margin-bottom: 0.3rem;
  }

  body.page-home .hero-name em {
    font-style: italic;
    color: var(--amber-light);
  }

  body.page-home .hn-word {
    display: inline-block;
    overflow: hidden;
    padding: 0.14em 0.08em;
    margin: -0.14em -0.08em;
    vertical-align: top;
  }

  body.page-home .hn-inner {
    display: inline-block;
    transform: translateY(115%);
    animation: homeWordRise 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  body.page-home .hn-word:nth-child(1) .hn-inner { animation-delay: 0.2s; }
  body.page-home .hn-word:nth-child(2) .hn-inner { animation-delay: 0.32s; }
  body.page-home .hn-word:nth-child(3) .hn-inner { animation-delay: 0.44s; }

  body.page-home .hero-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(0.75rem, 1.5vw, 0.9rem);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 2.2rem;
    opacity: 0;
    animation: homeFadeUp 0.7s ease forwards 0.3s;
  }

  body.page-home .hero-divider {
    width: 48px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--amber), transparent);
    margin: 0 auto 2.2rem;
    opacity: 0;
    animation: homeFadeIn 0.8s ease forwards 0.4s;
  }

  body.page-home .hero-description {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    font-weight: 300;
    line-height: 1.7;
    color: rgba(240,236,228,0.75);
    max-width: 560px;
    margin: 0 auto 3.5rem;
    opacity: 0;
    animation: homeFadeUp 0.7s ease forwards 0.5s;
  }

  body.page-home .cta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    opacity: 0;
    animation: homeFadeUp 0.8s ease forwards 0.65s;
  }

  body.page-home .cta-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.8rem;
    border: 1px solid var(--border-dim);
    text-decoration: none;
    background: rgba(255,255,255,0.025);
    transition: border-color 0.3s, background 0.3s, transform 0.3s;
    overflow: hidden;
    cursor: pointer;
  }

  body.page-home .cta-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s;
  }

  body.page-home .cta-card--recruiter::before {
    background: linear-gradient(135deg, rgba(200,146,42,0.08), transparent 60%);
  }

  body.page-home .cta-card--client::before {
    background: linear-gradient(135deg, rgba(255,255,255,0.04), transparent 60%);
  }

  body.page-home .cta-card::after {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    background: radial-gradient(180px circle at var(--mx, 50%) var(--my, 50%), rgba(224,168,58,0.85), transparent 70%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  body.page-home .cta-card:hover {
    border-color: rgba(200,146,42,0.45);
    background: rgba(255,255,255,0.04);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px -16px rgba(200,146,42,0.25);
  }

  body.page-home .cta-card:hover::before { opacity: 1; }
  body.page-home .cta-card:hover::after { opacity: 1; }

  body.page-home .cta-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 1rem;
  }

  body.page-home .cta-card--client .cta-tag { color: var(--muted); }

  body.page-home .cta-headline {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--off-white);
    margin-bottom: 0.75rem;
    flex: 1;
  }

  body.page-home .cta-sub {
    font-family: 'Syne', sans-serif;
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  body.page-home .cta-arrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--amber);
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: gap 0.2s;
  }

  body.page-home .cta-card--client .cta-arrow { color: rgba(240,236,228,0.4); }
  body.page-home .cta-card:hover .cta-arrow { gap: 0.9rem; }

  body.page-home footer[role="contentinfo"] {
    position: relative;
    z-index: 1;
    padding: 1.8rem 2.5rem;
    border-top: 1px solid var(--border-dim);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  body.page-home .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  body.page-home .footer-links a {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  body.page-home .footer-links a:hover { color: var(--amber); }

  body.page-home .footer-copy {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: rgba(122,117,112,0.5);
  }

  body.page-home .cursor-spotlight {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s ease;
    background: radial-gradient(480px circle at var(--spot-x, 50%) var(--spot-y, 35%), rgba(200,146,42,0.08), transparent 65%);
  }

  body.page-home .cursor-spotlight.is-on { opacity: 1; }

  @keyframes homeFadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes homeFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes homeWordRise {
    to { transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    body.page-home .hero-eyebrow,
    body.page-home .hero-title,
    body.page-home .hero-divider,
    body.page-home .hero-description,
    body.page-home .cta-grid {
      animation: none;
      opacity: 1;
    }
    body.page-home .hn-inner {
      animation: none;
      transform: none;
    }
    body.page-home .cursor-spotlight { display: none; }
  }

  @media (max-width: 600px) {
    body.page-home nav[aria-label="Principal"] { padding: 1.2rem 1.5rem; }
    body.page-home main#main { padding: 7rem 1.25rem 3rem; }
    body.page-home .cta-grid {
      grid-template-columns: 1fr;
      max-width: 420px;
    }
    body.page-home footer[role="contentinfo"] {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
    }
  }
</style>

<div class="hero">
  <p class="hero-eyebrow">{props.eyebrow}</p>
  <h1 class="hero-name">
    <span class="hn-word"><span class="hn-inner">Victor</span></span>
    <span class="hn-word"><span class="hn-inner"><em>de</em></span></span>
    <span class="hn-word"><span class="hn-inner"><em>Alcântara</em></span></span>
  </h1>
  <p class="hero-title">{props.title}</p>
  <div class="hero-divider"></div>
  <p class="hero-description">{props.description}</p>
  <div class="cta-grid">
    <a class="cta-card cta-card--recruiter" href={props.recruiterHref}>
      <span class="cta-tag">{props.recruiterTag}</span>
      <p class="cta-headline">{props.recruiterHeadline}</p>
      <p class="cta-sub">{props.recruiterSub}</p>
      <span class="cta-arrow">{props.recruiterArrow}</span>
    </a>

    <a class="cta-card cta-card--client" href={props.clientHref}>
      <span class="cta-tag">{props.clientTag}</span>
      <p class="cta-headline">{props.clientHeadline}</p>
      <p class="cta-sub">{props.clientSub}</p>
      <span class="cta-arrow">{props.clientArrow}</span>
    </a>
  </div>
</div>

<script>
  const finePointer = window.matchMedia('(pointer: fine)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scramble do eyebrow: caracteres aleatórios resolvem no texto final
  const eyebrow = document.querySelector<HTMLElement>('.hero-eyebrow');
  if (eyebrow && !reducedMotion) {
    const finalText = eyebrow.textContent ?? '';
    const glyphs = '!<>-_\\/[]{}=+*^?#';
    const totalFrames = Math.max(1, Math.round(finalText.length * 2.2));
    let frame = 0;
    const tick = () => {
      frame++;
      const settled = Math.floor((frame / totalFrames) * finalText.length);
      let out = '';
      for (let i = 0; i < finalText.length; i++) {
        const c = finalText[i];
        out = out + (i < settled || c === ' ' ? c : glyphs[Math.floor(Math.random() * glyphs.length)]);
      }
      eyebrow.textContent = out;
      if (settled < finalText.length) requestAnimationFrame(tick);
      else eyebrow.textContent = finalText;
    };
    setTimeout(() => requestAnimationFrame(tick), 150);
  }

  if (finePointer && !reducedMotion) {
    // Spotlight âmbar que segue o cursor com suavização
    const spot = document.createElement('div');
    spot.className = 'cursor-spotlight';
    spot.setAttribute('aria-hidden', 'true');
    document.body.appendChild(spot);

    let targetX = window.innerWidth / 2;
    let targetY = window.innerHeight * 0.35;
    let x = targetX;
    let y = targetY;
    let raf = 0;

    const step = () => {
      x += (targetX - x) * 0.1;
      y += (targetY - y) * 0.1;
      spot.style.setProperty('--spot-x', `${x}px`);
      spot.style.setProperty('--spot-y', `${y}px`);
      if (Math.abs(targetX - x) > 0.5 || Math.abs(targetY - y) > 0.5) {
        raf = requestAnimationFrame(step);
      } else {
        raf = 0;
      }
    };

    window.addEventListener('pointermove', (e) => {
      targetX = e.clientX;
      targetY = e.clientY;
      spot.classList.add('is-on');
      if (!raf) raf = requestAnimationFrame(step);
    }, { passive: true });

    // Glow border dos cards acompanha a posição do cursor
    const cards = document.querySelectorAll<HTMLElement>('.cta-card');
    for (const card of cards) {
      card.addEventListener('pointermove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
        card.style.setProperty('--my', `${e.clientY - rect.top}px`);
      }, { passive: true });
    }
  }
</script>
